# ── Server ────────────────────────────────────────────────────────────
PORT=8787
# Shared secret for /admin.html and /api/admin/*
ADMIN_TOKEN=change-me
# Salt for hashing visitor IPs (waitlist de-dupe). Never log raw IPs.
IP_SALT=change-me-too
DB_PATH=./data/game.db
# Optional ISO date shown in the "time until launch" countdown
LAUNCH_AT=
# Start already launched (admin can toggle at runtime; DB value wins once set)
LAUNCHED=false

# ── Economy ───────────────────────────────────────────────────────────
FEE_CLAIM_INTERVAL_SEC=60
CARD_THRESHOLD_USD=10
# Share of each fee claim that goes to the USDC card vault (rest becomes golden balls)
VAULT_SHARE=0.5
USD_PER_GOLDEN_BALL=0.25
MAX_BALLS_PER_DROP=40

# ── Chain (mock | solana) ─────────────────────────────────────────────
CHAIN_PROVIDER=mock
SOLANA_CLUSTER=mainnet-beta
RPC_URL=https://api.mainnet-beta.solana.com
# Token mint (the "CA"). Leave empty to show "CA soon".
TOKEN_MINT=
USDC_MINT=EPjFWyuyNv1qmEYfjEjQ9Ab4HgJs7jz8kRB2vPcAFNAG
# Secret keys as JSON byte arrays (e.g. contents of a solana-keygen file)
FEE_WALLET_SECRET_KEY=
VAULT_WALLET_SECRET_KEY=
# Keep this much SOL in the fee wallet for rent + tx fees
FEE_WALLET_RESERVE_SOL=0.05

# ── Card purchases (mock | http) ──────────────────────────────────────
CARD_PROVIDER=mock
CARD_API_URL=
CARD_API_KEY=
